{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tuist generate:*)",
      "Bash(tuist build:*)",
      "Bash(tuist test:*)",
      "Bash(tuist graph:*)",
      "Bash(tuist clean:*)",
      "Bash(bundle exec fastlane:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go list:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod verify:*)",
      "Bash(gofmt:*)",
      "Bash(./scripts/gen-cert.sh:*)",
      "Bash(./scripts/spki-pin.sh:*)",
      "Bash(curl -k https://localhost:8443/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git worktree list:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(swift --version)",
      "Bash(xcrun simctl list:*)"
    ],
    "deny": [
      "Read(./ios/build/**)",
      "Read(./ios/**/DerivedData/**)",
      "Read(./ios/**/*.xcodeproj/**)",
      "Read(./ios/**/*.xcworkspace/**)",
      "Read(./certs/**)",
      "Read(./backend/certs/**)",
      "Read(./.claude/worktrees/**)"
    ]
  }
}
