# Every build and test entry point for this repo. The same lanes run locally
# and on CI (`.github/workflows/ci.yml`), so a green CI run means the exact
# commands you can reproduce on your own machine passed.
#
# There is deliberately no Appfile: nothing here talks to App Store Connect,
# and the team id already lives in `ios/Tuist/ProjectDescriptionHelpers/
# Project+Module.swift`. Copying it into a second file would only let the two
# drift apart.

require "fileutils"
require "shellwords"
require "tmpdir"

ROOT        = File.expand_path("..", __dir__)
IOS_DIR     = File.join(ROOT, "ios")
BACKEND_DIR = File.join(ROOT, "backend")

WORKSPACE = File.join(IOS_DIR, "BankingTechStack.xcworkspace")
# Tuist's workspace scheme aggregates every module and every test bundle, so
# one scan invocation covers all of them. Regenerate and run
# `xcodebuild -workspace ... -list` if you need to see what it contains.
SCHEME = "BankingTechStack-Workspace"
UI_TEST_TARGET = "AppUITests"

# Build output must never land inside the repo (see the root CLAUDE.md), and
# sharing one path between lanes lets `test` and `e2e` reuse each other's work.
DERIVED_DATA = File.expand_path("~/Library/Developer/Xcode/DerivedData/BankingTechStack-fastlane")
OUTPUT_DIR = File.join(ROOT, "fastlane/test_output")

# Override for a machine without this simulator: `SIMULATOR="iPhone 17 Pro" fastlane ios test`.
SIMULATOR = ENV.fetch("SIMULATOR", "iPhone 17")

BACKEND_HOST = "localhost:8443"
BACKEND_URL = "https://#{BACKEND_HOST}"
SERVER_CERT = File.join(BACKEND_DIR, "certs/server.crt")
# Escaped once here: these are interpolated into shell commands, and a clone
# living under a path with spaces would otherwise split into two arguments.
SPKI_PIN_SH = File.join(IOS_DIR, "scripts/spki-pin.sh").shellescape
SET_LOCAL_PIN_SH = File.join(IOS_DIR, "scripts/set-local-pin.sh").shellescape

default_platform(:ios)

desc "Format, vet and test the Go backend"
lane :backend_check do
  # The steps live in the script, not here, so the CI job can run exactly the
  # same checks on a Linux runner without a Ruby toolchain.
  Dir.chdir(BACKEND_DIR) { sh("./scripts/check.sh") }
  UI.success("Backend checks passed")
end

platform :ios do
  desc "Everything that does not need a running server: backend checks + iOS unit tests"
  lane :ci do
    backend_check
    test
  end

  desc "Build every module and the app"
  lane :build do
    generate
    Dir.chdir(IOS_DIR) { sh("tuist build") }
  end

  desc "Run the mock-only unit tests (no server needed)"
  lane :test do
    generate
    run_tests(
      workspace: WORKSPACE,
      scheme: SCHEME,
      device: SIMULATOR,
      skip_testing: [UI_TEST_TARGET],
      derived_data_path: DERIVED_DATA,
      output_directory: OUTPUT_DIR,
      output_types: "junit",
      result_bundle: true
    )
  end

  desc "End-to-end: start the Go backend, run AppUITests against it, then stop it"
  lane :e2e do
    started_backend = false
    previous_pin = nil

    begin
      if backend_healthy?
        UI.important("A backend is already answering on #{BACKEND_URL} — reusing it")
      else
        start_backend
        started_backend = true
      end

      # Read the pin from the live server rather than from the certificate on
      # disk: that way a reused backend serving an older certificate is still
      # matched correctly. Without this the app fails every request with
      # NetworkError.pinningFailure and the UI tests fail at the login screen.
      previous_pin = sync_local_pin

      generate
      run_tests(
        workspace: WORKSPACE,
        scheme: SCHEME,
        device: SIMULATOR,
        only_testing: [UI_TEST_TARGET],
        derived_data_path: DERIVED_DATA,
        output_directory: OUTPUT_DIR,
        output_types: "junit",
        result_bundle: true
      )
    ensure
      # Both steps must run even when the tests fail, or the next run starts
      # from a dirty working tree and a stray server holding port 8443.
      stop_backend if started_backend
      restore_local_pin(previous_pin) if previous_pin
    end
  end

  desc "Regenerate the Xcode workspace — it is gitignored, so nothing builds without this"
  private_lane :generate do
    Dir.chdir(IOS_DIR) do
      sh("tuist install")
      sh("tuist generate --no-open")
    end
  end
end

# --- Backend lifecycle -------------------------------------------------------

def backend_healthy?
  # -k skips verification: this is the self-signed local certificate, and the
  # app's own pinning is what actually checks it.
  system("curl -ksf #{BACKEND_URL.shellescape}/health -o /dev/null")
end

def server_pid_file
  File.join(OUTPUT_DIR, "backend.pid")
end

def start_backend
  FileUtils.mkdir_p(OUTPUT_DIR)

  unless File.exist?(SERVER_CERT)
    UI.message("No local certificate — generating one")
    Dir.chdir(BACKEND_DIR) { sh("./scripts/gen-cert.sh") }
    # This lane puts the committed pin back when it finishes, so the new
    # certificate will not match it afterwards. That is fine for CI, which
    # throws the machine away, but a developer needs to know.
    UI.important("Generated a new certificate. To keep using it outside this lane, run:")
    UI.important("  ios/scripts/set-local-pin.sh --from-cert backend/certs/server.crt")
  end

  # Build first and run the binary directly instead of `go run`: `go run`
  # starts the server as a child process, so killing it would leave the real
  # server holding port 8443. The binary goes to a temp dir, never into the repo.
  binary = File.join(Dir.tmpdir, "banking-tech-stack-server")
  Dir.chdir(BACKEND_DIR) { sh("go build -o #{binary.shellescape} ./cmd/server") }

  log = File.join(OUTPUT_DIR, "backend.log")
  # The server resolves certs/server.{crt,key} relative to the working
  # directory, so it has to start from backend/.
  pid = Process.spawn(binary, chdir: BACKEND_DIR, out: log, err: log)
  Process.detach(pid)
  File.write(server_pid_file, pid)
  UI.message("Started the backend (pid #{pid}), logging to #{log}")

  wait_for_backend(log)
end

def wait_for_backend(log)
  30.times do
    return if backend_healthy?
    sleep(1)
  end

  stop_backend
  UI.user_error!("The backend did not answer on #{BACKEND_URL}/health within 30s. Log:\n#{File.read(log)}")
end

def stop_backend
  return unless File.exist?(server_pid_file)

  pid = File.read(server_pid_file).to_i
  begin
    Process.kill("TERM", pid)
    UI.message("Stopped the backend (pid #{pid})")
  rescue Errno::ESRCH
    UI.important("Backend process #{pid} was already gone")
  end
  File.delete(server_pid_file)
end

# --- Certificate pin ---------------------------------------------------------

# Points the app's `.local` pin at the key the running server is actually
# serving. Returns the pin it replaced so the caller can put it back, or nil
# when the file was already correct and nothing was touched.
def sync_local_pin
  live_pin = sh("#{SPKI_PIN_SH} --host #{BACKEND_HOST.shellescape}", log: false).strip
  current_pin = sh("#{SET_LOCAL_PIN_SH} --print", log: false).strip

  if live_pin == current_pin
    UI.message("The pinned key already matches the running server")
    return nil
  end

  UI.important("Pointing the .local pin at the running server for the duration of this run")
  sh("#{SET_LOCAL_PIN_SH} #{live_pin.shellescape}")
  current_pin
end

# Writes the old value back rather than `git checkout`-ing the file, so an
# unrelated uncommitted edit in PinningConfiguration.swift is not thrown away.
def restore_local_pin(pin)
  sh("#{SET_LOCAL_PIN_SH} #{pin.shellescape}", log: false)
  UI.message("Restored the previous .local pin")
end
